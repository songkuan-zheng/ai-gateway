# Copy this file to .env.production and replace every placeholder before starting.

GATEWAY_IMAGE=next-ai-gateway:prod
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PUBLISHED_PORT=3000

# Required for production client auth. Clients send: Authorization: Bearer <key>
AUTH_ENABLED=true
AUTH_MODE=static_api_key
AUTH_REQUIRED=true
AUTH_STATIC_API_KEYS=replace-with-one-or-more-client-keys

# Required for /manager/* routes.
MANAGER_API_KEY=replace-with-manager-admin-key

# Provider credentials. Keep only the providers you use.
OPENAI_API_KEY=sk-replace-me
# ANTHROPIC_API_KEY=sk-ant-replace-me
# GEMINI_API_KEY=replace-me
# XAI_API_KEY=replace-me

# Provider defaults.
DEFAULT_TARGET_PROVIDER=openai
DEFAULT_OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_TIMEOUT_MS=60000

# Billing stays disabled in this production template until real rates and a durable
# delivery path are configured. Do not enable it with the zero-value examples below.
BILLING_ENABLED=false
BILLING_DELIVERY_MODE=async
BILLING_REQUIRE_USAGE=false
BILLING_REQUIRE_RATES=false
OPENAI_INPUT_PRICE_PER_1M=0
OPENAI_OUTPUT_PRICE_PER_1M=0
OPENAI_CACHE_READ_PRICE_PER_1M=0
OPENAI_CACHE_WRITE_PRICE_PER_1M=0

# Optional shared Redis backend for multi-instance deployments.
# To share state across gateway instances, change the storage types below to redis
# before starting compose with:
# docker compose --env-file .env.production -f docker-compose.prod.yml --profile redis up -d
REDIS_URL=redis://redis:6379/0
GATEWAY_IDEMPOTENCY_STORAGE_TYPE=memory
GATEWAY_IDEMPOTENCY_MAX_RESPONSE_BYTES=4194304
GATEWAY_IDEMPOTENCY_MAX_TOTAL_BYTES=134217728
GATEWAY_UPSTREAM_CONCURRENCY_STORAGE_TYPE=memory
GATEWAY_UPSTREAM_CIRCUIT_BREAKER_STORAGE_TYPE=memory
GATEWAY_SCHEDULING_STORAGE_TYPE=memory
PROVIDER_HEALTH_CHECK_STORAGE_TYPE=memory
PRECHECK_STORAGE_TYPE=memory

# Local durable state inside the gateway-data Docker volume.
RAW_TRACE_SPOOL_DIR=/data/gateway/raw-trace
AGENT_STORAGE_TYPE=memory
AGENT_STORAGE_DIR=/data/gateway/agent

GATEWAY_LOG_LEVEL=warn
